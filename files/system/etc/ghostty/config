# System-wide Ghostty defaults, included from ~/.config/ghostty/config.ghostty
# (new users get that file from /etc/skel). Override anything in your own config.

# Cursor shaders from https://github.com/sahaj-b/ghostty-cursor-shaders
# (vendored in /usr/share/ghostty-cursor-shaders)
custom-shader = /usr/share/ghostty-cursor-shaders/cursor_warp.glsl
custom-shader = /usr/share/ghostty-cursor-shaders/ripple_cursor.glsl
# Keep shaders animating when the window is unfocused (otherwise the line
# cursor effects freeze when it turns into a hollow block)
custom-shader-animation = always
