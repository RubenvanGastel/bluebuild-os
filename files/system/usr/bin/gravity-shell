#!/bin/sh
# Starts or talks to the Gravity Quickshell desktop.
#   gravity-shell          start the shell (niri runs this at startup)
#   gravity-shell lock     lock the screen
#   gravity-shell wallpaper [image]
#                          open the wallpaper picker, or set the wallpaper to image
#   gravity-shell ...      any other qs arguments, e.g. `gravity-shell ipc show`
#
# A copy in ~/.config/quickshell/gravity takes precedence over the system one, so you can
# tweak it without rebuilding the image:
#   cp -r /usr/share/gravity-shell ~/.config/quickshell/gravity
set -eu

user_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/gravity"
if [ -f "$user_dir/shell.qml" ]; then
    dir="$user_dir"
else
    dir=/usr/share/gravity-shell
fi

case "${1:-}" in
    "")
        # niri's own light or dark, GTK theme and accent; GNOME keeps its own.
        /usr/libexec/gravity-theme-session niri || true
        exec qs -p "$dir"
        ;;
    lock) exec qs -p "$dir" ipc call lock lock ;;
    wallpaper)
        if [ -n "${2:-}" ]; then
            exec qs -p "$dir" ipc call wallpaper set "$(realpath -- "$2")"
        fi
        exec qs -p "$dir" ipc call wallpaper toggle
        ;;
    *) exec qs -p "$dir" "$@" ;;
esac
