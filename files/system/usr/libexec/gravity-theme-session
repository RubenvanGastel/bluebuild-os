#!/bin/sh
# Keeps the theme the Gravity shell sets under niri apart from GNOME's own.
#   gravity-theme-session niri    (gravity-shell runs this before it starts)
#   gravity-theme-session gnome   (GNOME runs this at login, from /etc/xdg/autostart)
# Both sessions share one dconf database, so light or dark, the GTK 3 theme and the accent
# colour chosen in one would show up in the other. Whenever the session changes, the values
# that are set now are saved as the previous session's, and this session's are put back.
set -eu

session=$1
dir="${XDG_STATE_HOME:-$HOME/.local/state}/gravity-shell"
schema=org.gnome.desktop.interface
keys="color-scheme gtk-theme accent-color"

mkdir -p "$dir"
owner=$(cat "$dir/theme-owner" 2>/dev/null || true)
[ "$owner" = "$session" ] && exit 0

# Nothing recorded yet: what is set now is GNOME's.
for key in $keys; do
    printf '%s %s\n' "$key" "$(gsettings get "$schema" "$key")"
done > "$dir/theme-${owner:-gnome}"

if [ -f "$dir/theme-$session" ]; then
    while read -r key value; do
        gsettings set "$schema" "$key" "$value"
    done < "$dir/theme-$session"
elif [ "$session" = niri ]; then
    # The shell's first start: dark, its default. It sets the GTK theme and accent itself.
    gsettings set "$schema" color-scheme prefer-dark
fi

echo "$session" > "$dir/theme-owner"
