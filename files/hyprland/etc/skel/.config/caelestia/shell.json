{
    "general": {
        "apps": {
            "terminal": ["ghostty"],
            "playback": ["flatpak", "run", "io.github.diegopvlk.Cine"],
            "explorer": ["nautilus"]
        },
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
