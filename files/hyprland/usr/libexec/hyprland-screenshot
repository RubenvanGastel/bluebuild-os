#!/usr/bin/bash
# Print on the hyprland images, like niri's screenshot: pick a region (Esc cancels), then
# it's saved to Screenshots in your Pictures folder and copied to the clipboard.
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
file="$dir/Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png"

region="$(slurp -d)" || exit 0
mkdir -p "$dir"
grim -g "$region" "$file"
wl-copy --type image/png <"$file"
notify-send -a Screenshot -i "$file" "Screenshot captured" \
    "Saved to $(basename "$file") in $dir and copied to the clipboard"
