# Colours from the Gravity shell, which writes ~/.config/ghostty/themes/gravity from
# its palette (light or dark, accent or wallpaper) and tells Ghostty to reload.
theme = gravity
# Tabs and titlebar from those colours too: gravity-shell's GTK css leaves libadwaita's
# tab colours alone, so with window-theme = auto they came out inverted.
window-theme = ghostty
