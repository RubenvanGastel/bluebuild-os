pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Colours for the whole shell. Config.colors picks the palette:
//   "default"    the built-in one: Material You from GNOME's blue accent, so the shell
//                matches GNOME apps out of the box. Needs no matugen.
//   "accent"     matugen derives a Material You scheme from one colour (Config.accent).
//   "wallpaper"  matugen derives one from the wallpaper.
// matugen's roles are mapped onto the same names, so every widget follows along.
// Appearance picks the light or dark variant (shownLight: while the wallpaper picker
// previews a wallpaper, that one's).
Singleton {
    id: root

    // Default palette: matugen's tonal spot scheme for GNOME's accent blue (#3584e4). The
    // role each name takes is noted.
    readonly property var darkDefaults: ({
            night: "#0c0e13",      // surface_container_lowest
            deep: "#191c20",       // surface_container_low
            dusk: "#282a2f",       // surface_container_high
            glow: "#bdc7dc",       // secondary
            gold: "#a7c8ff",       // primary (the accent)
            goldInk: "#04305f",    // on_primary (text on the accent)
            tonal: "#3d4758",      // secondary_container (selected-but-quiet fills)
            tonalInk: "#d9e3f8",   // on_secondary_container
            amber: "#dbbce1",      // tertiary
            rose: "#ffb4ab",       // error
            text: "#e1e2e9",       // on_surface
            textDim: "#c4c6cf",    // on_surface_variant
            panel: "#1d2024"       // surface_container (the bar, cards, fields)
        })

    readonly property var lightDefaults: ({
            night: "#ffffff",
            deep: "#f3f3fa",
            dusk: "#e7e8ee",
            glow: "#555f71",
            gold: "#3e5f90",
            goldInk: "#ffffff",
            tonal: "#d9e3f8",
            tonalInk: "#121c2b",
            amber: "#6e5676",
            rose: "#ba1a1a",
            text: "#191c20",
            textDim: "#43474e",
            panel: "#ededf4"
        })

    // Accent colours to pick from for "accent" (any other colour works too): GNOME's own,
    // with the name its accent-color setting has for each.
    readonly property var accents: [
        { value: "#3584e4", label: "Blue", gnome: "blue" },
        { value: "#2190a4", label: "Teal", gnome: "teal" },
        { value: "#3a944a", label: "Green", gnome: "green" },
        { value: "#c88800", label: "Yellow", gnome: "yellow" },
        { value: "#ed5b00", label: "Orange", gnome: "orange" },
        { value: "#e62d42", label: "Red", gnome: "red" },
        { value: "#d56199", label: "Pink", gnome: "pink" },
        { value: "#9141ac", label: "Purple", gnome: "purple" },
        { value: "#6f8396", label: "Slate", gnome: "slate" }
    ]

    // Light or dark as shown in the shell, which may be a preview; and as set for the apps.
    readonly property bool light: Appearance.shownLight
    readonly property bool appliedLight: Appearance.light
    readonly property var defaults: light ? lightDefaults : darkDefaults

    readonly property var roles: ({
            night: "surface_container_lowest",
            deep: "surface_container_low",
            dusk: "surface_container_high",
            glow: "secondary",
            gold: "primary",
            goldInk: "on_primary",
            tonal: "secondary_container",
            tonalInk: "on_secondary_container",
            amber: "tertiary",
            rose: "error",
            text: "on_surface",
            textDim: "on_surface_variant",
            panel: "surface_container"
        })

    // matugen's scheme variants for "accent" and "wallpaper" colours (Config.colorScheme).
    readonly property var schemes: [
        { id: "scheme-tonal-spot", label: "Tonal" },
        { id: "scheme-vibrant", label: "Vibrant" },
        { id: "scheme-expressive", label: "Expressive" },
        { id: "scheme-content", label: "Content" },
        { id: "scheme-fidelity", label: "Fidelity" },
        { id: "scheme-fruit-salad", label: "Fruit salad" },
        { id: "scheme-rainbow", label: "Rainbow" },
        { id: "scheme-neutral", label: "Neutral" },
        { id: "scheme-monochrome", label: "Mono" }
    ]

    // While the wallpaper picker is open: the wallpaper it has selected, so the colours
    // preview that one before it is applied. Empty = Config.wallpaperPath.
    property string previewPath: ""

    // Palette generated by matugen for the current colour or wallpaper and scheme; {} until
    // ready.
    property var generated: ({})
    // Which "source|scheme|mode" `generated` belongs to; the source is "color:#rrggbb" or
    // "image:/path".
    property string generatedKey
    readonly property bool generatedColors: Config.colors === "wallpaper" || Config.colors === "accent"
    readonly property bool fromGenerated: generatedColors && generated.night !== undefined
    readonly property var palette: fromGenerated ? generated : defaults

    property color night: palette.night
    property color deep: palette.deep
    property color dusk: palette.dusk

    property color glow: palette.glow
    property color gold: palette.gold
    property color goldInk: palette.goldInk
    property color tonal: palette.tonal
    property color tonalInk: palette.tonalInk
    property color amber: palette.amber
    property color rose: palette.rose

    property color text: palette.text
    property color textDim: palette.textDim
    // Solid surface for the bar, notification cards and the password field.
    property color surface: palette.panel

    // Light and dark, and one palette to the next, fade into each other rather than snap.
    readonly property int colorFade: 450

    Behavior on night {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on deep {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on dusk {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on glow {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on gold {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on goldInk {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on tonal {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on tonalInk {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on amber {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on rose {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on text {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on textDim {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }
    Behavior on surface {
        ColorAnimation {
            duration: root.colorFade
            easing.type: Easing.InOutQuad
        }
    }

    // A hovered fill: a little lighter on dark surfaces, a little darker on light ones.
    function hover(c: color, amount: real): color {
        return light ? Qt.darker(c, 1 + (amount - 1) / 2) : Qt.lighter(c, amount);
    }

    // Behind the lock screen text: the wallpaper is darkened (lightened in light mode)
    // with this.
    readonly property color scrim: Qt.alpha(night, 0.35)

    // Material 3 Expressive's typeface; falls back to the system sans if it's missing.
    readonly property string font: "Google Sans Flex"

    // Thickness of the bar (its height, or its width along a side); popups line up
    // against it.
    readonly property int barSize: 42
    // Screen edge the bar runs along, and whether that is a side (a vertical bar).
    readonly property string barEdge: ["top", "bottom", "left", "right"].includes(Config.barPosition) ? Config.barPosition : "top"
    readonly property bool barVertical: barEdge === "left" || barEdge === "right"
    // "edge": against the screen edge, curving into the screen. "floating": a fully rounded
    // bar Theme.gap from the edge, with panels as separate cards under it. "frame": as
    // "edge", with a thin border around the rest of the screen and rounded inner corners.
    readonly property string barStyle: ["edge", "floating", "frame"].includes(Config.barStyle) ? Config.barStyle : "edge"
    // From the screen edge to the bar's outer side, and to its inner side (where windows
    // and panels start).
    readonly property int barInset: barStyle === "floating" ? gap : 0
    readonly property int barOuter: barInset + barSize
    // Thickness of the frame along the other three edges (0 without one).
    readonly property int frameSize: barStyle === "frame" ? 10 : 0
    // Radius of the inverted corners below the bar.
    readonly property int barCorner: 24
    // Gap between popups and the bar or the screen edge.
    readonly property int gap: 12

    readonly property int fast: 180
    readonly property int normal: 320
    readonly property int slow: 620

    // Emphasized: things that move from one place to another and stay on screen.
    readonly property var emphasized: [0.2, 0.0, 0.0, 1.0, 1.0, 1.0]
    // Emphasized accelerate: things that leave.
    readonly property var depart: [0.3, 0.0, 0.8, 0.15, 1.0, 1.0]

    // Set when matugen is missing or could not read the image or colour; the picker and the
    // settings show it.
    property string error: ""

    readonly property string cacheDir: (Quickshell.env("XDG_CACHE_HOME") || Quickshell.env("HOME") + "/.cache") + "/gravity-shell"
    readonly property string mode: light ? "light" : "dark"
    // What the colours are generated from: the accent, or the wallpaper (the one being
    // previewed in the picker, for `wanted`).
    readonly property string appliedSource: Config.colors === "accent" ? "color:" + Config.accent : "image:" + Config.wallpaperPath
    readonly property string wantedSource: Config.colors === "accent" ? appliedSource : "image:" + (previewPath || Config.wallpaperPath)
    // "source|scheme|mode" of the applied colours; only their palette goes in the cache.
    readonly property string appliedKey: appliedSource + "|" + Config.colorScheme + "|" + (appliedLight ? "light" : "dark")
    // Waits until it is known whether the wallpaper wants light or dark.
    readonly property string wanted: Config.ready && Appearance.ready && generatedColors && (Config.colors === "accent" || Appearance.knows(previewPath || Config.wallpaperPath)) ? wantedSource + "|" + Config.colorScheme + "|" + mode : ""

    // Palettes generated by key, kept across restarts (palettes.json), so browsing back and
    // forth is instant. Like the brightness cache, a wallpaper replaced under the same name
    // keeps its old palette until the cache is removed.
    property var memo: ({})
    // Keys matugen failed on while making them ahead, so they aren't tried again and again.
    property var failed: ({})
    property string cachedKey

    // Palette of the applied wallpaper (not a preview), for niri.
    property var appliedGenerated: ({})

    onWantedChanged: regenerate.restart()
    // Applying the wallpaper that is being previewed leaves `wanted` as it was, but its
    // palette still has to become the applied one (for niri and the cache).
    onAppliedKeyChanged: regenerate.restart()

    function use(key: string, palette: var): void {
        error = "";
        generated = palette;
        generatedKey = key;
        if (key === appliedKey) {
            appliedGenerated = palette;
        }
        if (key === appliedKey && key !== cachedKey) {
            cachedKey = key;
            cacheFile.setText(JSON.stringify({ key, palette }, null, 2));
        }
    }

    // Coalesces a wallpaper and a scheme change made together into one matugen run.
    Timer {
        id: regenerate

        interval: 100
        onTriggered: {
            if (root.wanted === "" || root.generatedKey === root.wanted) {
                // e.g. a previewed wallpaper that has just been applied: cache it now.
                if (root.wanted !== "")
                    root.use(root.generatedKey, root.generated);
                root.makeAhead();
                return;
            }
            if (root.memo[root.wanted]) {
                root.use(root.wanted, root.memo[root.wanted]);
                root.makeAhead();
                return;
            }
            // One run at a time; onExited comes back here when it is done.
            if (!matugen.running)
                root.run(root.wanted, false);
        }
    }

    function run(key: string, ahead: bool): void {
        const parts = key.split("|");
        matugen.key = key;
        matugen.ahead = ahead;
        matugen.mode = parts.pop();
        matugen.scheme = parts.pop();
        const source = parts.join("|");
        matugen.color = source.startsWith("color:") ? source.slice(6) : "";
        matugen.path = source.startsWith("image:") ? source.slice(6) : "";
        matugen.running = true;
    }

    // While the picker is open, the palettes of the wallpapers around the selected one are
    // made ahead (nearest first), so the colours change as soon as you get to one rather
    // than after matugen has read the whole image.
    readonly property int aheadCount: 8

    function makeAhead(): void {
        if (matugen.running || Config.colors !== "wallpaper" || !Config.ready || !Appearance.ready)
            return;
        const list = Appearance.upcoming;
        const at = Math.max(0, list.indexOf(previewPath));
        const near = list.map((p, i) => [p, Math.abs(i - at)]).sort((a, b) => a[1] - b[1]).slice(0, aheadCount + 1);
        for (const [path] of near) {
            if (!Appearance.knows(path))
                continue;
            const light = Appearance.mode === "wallpaper" ? Appearance.brightness[path] > Appearance.brightThreshold : root.light;
            const key = "image:" + path + "|" + Config.colorScheme + "|" + (light ? "light" : "dark");
            if (!memo[key] && !failed[key]) {
                run(key, true);
                return;
            }
        }
    }

    // A newly measured or listed wallpaper may be one to make ahead.
    Connections {
        target: Appearance

        function onBrightnessChanged(): void {
            if (!matugen.running)
                regenerate.restart();
        }
        function onUpcomingChanged(): void {
            if (!matugen.running)
                regenerate.restart();
        }
    }

    Process {
        id: matugen

        // What this run is for; set together just before it starts. `ahead`: made ahead for
        // the picker, not shown yet.
        property string key
        property bool ahead
        property string path
        property string color
        property string scheme
        property string mode

        // From a colour, or an image. Videos are read from their poster frame, taken here
        // if it isn't cached yet.
        command: ["sh", "-c", `
            if [ -n "$5" ]; then
                exec matugen color hex "$5" --dry-run --json hex -m "$4" -t "$2"
            fi
            mkdir -p "$0" "$(dirname "$1")" || exit 1
            if [ -n "$3" ] && [ ! -s "$1" ]; then
                tmp="$1.$$.jpg"
                ffmpeg -loglevel error -i "$3" -frames:v 1 -q:v 3 -y "$tmp"
                [ -s "$tmp" ] && mv -f "$tmp" "$1"
            fi
            # matugen 4 asks which colour to use when an image has several, and fails
            # without a terminal; index 0 is the one matugen 3 picked. Older ones lack the flag.
            matugen image "$1" --dry-run --json hex -m "$4" -t "$2" --source-color-index 0 2>/dev/null ||
                exec matugen image "$1" --dry-run --json hex -m "$4" -t "$2"
        `, root.cacheDir, path ? Media.stillOf(path) : "", scheme, Media.isVideo(path) ? path : "", mode, color]
        stdout: StdioCollector {
            id: out
        }
        stderr: StdioCollector {
            id: err
        }
        onExited: code => {
            if (code !== 0 && matugen.ahead) {
                root.failed[matugen.key] = true;
            } else if (code !== 0) {
                root.error = code === 127 ? "matugen is not installed" : matugen.color ? "matugen could not read this colour" : "matugen could not read this image";
                console.warn("gravity: matugen failed:", err.text.trim());
                root.generated = {};
                root.generatedKey = "";
            } else {
                const palette = root.parse(out.text, matugen.mode);
                if (palette) {
                    root.memo[matugen.key] = palette;
                    saveMemo.restart();
                    if (!matugen.ahead || matugen.key === root.wanted)
                        root.use(matugen.key, palette);
                } else if (!matugen.ahead) {
                    root.error = "matugen gave unexpected output";
                }
            }
            // The wallpaper may have changed meanwhile; otherwise the next one to make ahead.
            regenerate.restart();
        }
    }

    // matugen 3+ nests colours as colors.<role>.default (4 as {color: hex} there); 2.x used
    // colors.<mode>.<role>.
    function parse(text: string, mode: string): var {
        let data;
        try {
            data = JSON.parse(text.slice(text.indexOf("{")));
        } catch (e) {
            return null;
        }
        const c = data.colors ?? {};
        const palette = {};
        for (const name in roles) {
            const role = roles[name];
            let v = c[role]?.default ?? c[role]?.[mode] ?? c[mode]?.[role];
            if (typeof v === "object")
                v = v?.color;
            if (typeof v !== "string")
                return null;
            palette[name] = v;
        }
        return palette;
    }

    // niri's colours (included by its config), following the applied palette only, so
    // browsing in the picker doesn't recolour every window. A new wallpaper keeps the
    // previous palette until its own is ready, rather than flashing the defaults.
    readonly property var niriPalette: generatedColors && appliedGenerated.gold !== undefined ? appliedGenerated : appliedLight ? lightDefaults : darkDefaults
    readonly property string niriConfig: `// Written by gravity-shell from its colours; edits are overwritten.
layout {
    focus-ring {
        active-color "${niriPalette.gold}"
        inactive-color "${niriPalette.dusk}"
    }
    border {
        active-color "${niriPalette.gold}"
        inactive-color "${niriPalette.dusk}"
        urgent-color "${niriPalette.rose}"
    }
}
overview {
    backdrop-color "${niriPalette.night}"
}
`

    onNiriConfigChanged: niriWrite.restart()

    // GNOME apps take one of a few named accents: the one nearest in hue to the shell's,
    // or slate when that is nearly grey.
    readonly property string gnomeAccent: {
        const c = Qt.color(niriPalette.gold);
        if (c.hslSaturation < 0.12 || c.hslHue < 0)
            return "slate";
        let best = "blue", bestDistance = 2;
        for (const a of accents) {
            const h = Qt.color(a.value).hslHue;
            if (a.gnome === "slate")
                continue;
            const d = Math.min(Math.abs(h - c.hslHue), 1 - Math.abs(h - c.hslHue));
            if (d < bestDistance) {
                best = a.gnome;
                bestDistance = d;
            }
        }
        return best;
    }

    onGnomeAccentChanged: gnomeWrite.restart()

    // --- colours for apps ------------------------------------------------------------------
    // Each from the applied palette (like niri's), and each can be turned off in the
    // settings (Config.themeGtk, themeQt, themeGhostty), which returns it to its own colours.

    readonly property string configHome: Quickshell.env("XDG_CONFIG_HOME") || Quickshell.env("HOME") + "/.config"

    function mix(a: color, b: color, t: real): color {
        return Qt.rgba(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1);
    }

    function hex(c: color): string {
        return Qt.color(c).toString();
    }

    // Material has no greens or yellows, so terminal colours (and KDE's positive and
    // neutral) keep their usual hues, at a lightness that reads on the background.
    // Red, green, yellow, blue, magenta, cyan.
    readonly property var ansiHues: [0, 125, 48, 215, 300, 185].map(h => h / 360)
    readonly property var ansiNormal: ansiHues.map(h => Qt.hsla(h, 0.6, appliedLight ? 0.38 : 0.68, 1))
    readonly property var ansiBright: ansiHues.map(h => Qt.hsla(h, 0.75, appliedLight ? 0.3 : 0.78, 1))

    Connections {
        target: Config

        function onThemeGtkChanged(): void {
            gnomeWrite.restart();
        }
    }

    // GTK: the GNOME accent (off: GNOME's own, blue). Light or dark is Appearance's.
    Timer {
        id: gnomeWrite

        interval: 200
        onTriggered: {
            if (!Config.ready || !Appearance.ready)
                return;
            gnomeProc.running = false;
            gnomeProc.running = true;
        }
    }

    Process {
        id: gnomeProc

        command: ["sh", "-c", Config.themeGtk ? '[ "$(gsettings get org.gnome.desktop.interface accent-color)" = "\'$0\'" ] || gsettings set org.gnome.desktop.interface accent-color "$0"' : "gsettings reset org.gnome.desktop.interface accent-color", root.gnomeAccent]
    }

    // Qt: a qt6ct colour scheme (QT_QPA_PLATFORMTHEME=qt6ct, see environment.d), in
    // QPalette's role order. KDE apps also read KDE's colours from kdeglobals.
    readonly property string qtScheme: {
        const p = niriPalette;
        const roles = c => [
            c.text,                       // WindowText
            p.dusk,                       // Button
            mix(p.dusk, p.text, 0.2),     // Light
            mix(p.dusk, p.text, 0.1),     // Midlight
            mix(p.dusk, p.night, 0.7),    // Dark
            mix(p.dusk, p.night, 0.4),    // Mid
            c.text,                       // Text
            p.night,                      // BrightText
            c.text,                       // ButtonText
            p.night,                      // Base
            p.deep,                       // Window
            "#000000",                    // Shadow
            c.highlight,                  // Highlight
            c.highlightInk,               // HighlightedText
            p.gold,                       // Link
            p.amber,                      // LinkVisited
            p.panel,                      // AlternateBase
            "#000000",                    // NoRole
            p.dusk,                       // ToolTipBase
            p.text,                       // ToolTipText
            p.textDim,                    // PlaceholderText
            c.highlight                   // Accent
        ].map(hex).join(", ");
        const active = { text: p.text, highlight: p.gold, highlightInk: p.goldInk };
        const disabled = { text: mix(p.textDim, p.deep, 0.5), highlight: p.dusk, highlightInk: p.textDim };
        return `# Written by gravity-shell from its colours; edits are overwritten.
[ColorScheme]
active_colors=${roles(active)}
disabled_colors=${roles(disabled)}
inactive_colors=${roles(active)}
`;
    }

    readonly property string kdeColors: {
        const p = niriPalette;
        const rgb = c => {
            const q = Qt.color(c);
            return [q.r, q.g, q.b].map(v => Math.round(v * 255)).join(",");
        };
        const group = (name, bg, alt, fg) => `[Colors:${name}]
BackgroundNormal=${rgb(bg)}
BackgroundAlternate=${rgb(alt)}
ForegroundNormal=${rgb(fg)}
ForegroundInactive=${rgb(mix(fg, bg, 0.3))}
ForegroundActive=${rgb(p.gold)}
ForegroundLink=${rgb(p.gold)}
ForegroundVisited=${rgb(p.amber)}
ForegroundNegative=${rgb(p.rose)}
ForegroundNeutral=${rgb(ansiNormal[2])}
ForegroundPositive=${rgb(ansiNormal[1])}
DecorationFocus=${rgb(p.gold)}
DecorationHover=${rgb(p.gold)}
`;
        return [
            group("View", p.night, p.panel, p.text),
            group("Window", p.deep, p.panel, p.text),
            group("Header", p.deep, p.panel, p.text),
            group("Button", p.dusk, p.panel, p.text),
            group("Tooltip", p.dusk, p.panel, p.text),
            group("Complementary", p.dusk, p.panel, p.text),
            group("Selection", p.gold, p.gold, p.goldInk)
        ].join("\n");
    }

    readonly property string qtState: Config.themeQt ? qtScheme + kdeColors : "off"

    onQtStateChanged: qtWrite.restart()

    Timer {
        id: qtWrite

        interval: 200
        onTriggered: {
            if (!Config.ready || !Appearance.ready)
                return;
            qtProc.running = false;
            qtProc.running = true;
        }
    }

    // On: the scheme goes in qt6ct/colors/gravity.conf and qt6ct.conf uses it as its
    // palette; KDE's colour groups replace any in kdeglobals. Off: qt6ct's custom palette is
    // turned off and the colour groups are taken out again. Only those keys and groups
    // change, so the rest of both files (fonts, icons, style) stays yours.
    Process {
        id: qtProc

        command: ["sh", "-c", `
            dir="$0/qt6ct" conf="$0/qt6ct/qt6ct.conf" scheme="$0/qt6ct/colors/gravity.conf" kde="$0/kdeglobals"
            if [ "$1" = on ]; then
                mkdir -p "$dir/colors" && printf "%s" "$2" > "$scheme.tmp" && mv -f "$scheme.tmp" "$scheme" || exit 1
                [ -f "$conf" ] || : > "$conf"
            fi
            if [ -f "$conf" ]; then
                awk -v on="$1" -v path="$scheme" '
                    function put() {
                        if (done) return
                        if (on == "on") print "color_scheme_path=" path
                        print "custom_palette=" (on == "on" ? "true" : "false")
                        done = 1
                    }
                    /^\\[/ { print; sec = $0; if (sec == "[Appearance]") put(); next }
                    sec == "[Appearance]" && /^custom_palette=/ { next }
                    sec == "[Appearance]" && on == "on" && /^color_scheme_path=/ { next }
                    { print }
                    END { if (!done) { print "[Appearance]"; put() } }
                ' "$conf" > "$conf.new" || exit 1
                # Rewritten in place, not moved, so qt6ct's watch on the file stays.
                cmp -s "$conf.new" "$conf" || cat "$conf.new" > "$conf"
                rm -f "$conf.new"
            fi
            if [ -f "$kde" ] || [ "$1" = on ]; then
                {
                    # Without the colour groups, and blank lines only between what is left.
                    if [ -f "$kde" ]; then
                        awk '/^\\[/ { skip = /^\\[Colors:/ } !skip { if ($0 == "") { blank++; next } if (n++) while (blank) { print ""; blank-- } blank = 0; print }' "$kde"
                    fi
                    if [ "$1" = on ]; then
                        [ -s "$kde" ] && echo
                        printf "%s" "$3"
                    fi
                } > "$kde.tmp" && mv -f "$kde.tmp" "$kde"
            fi
        `, root.configHome, Config.themeQt ? "on" : "off", root.qtScheme, root.kdeColors]
        onExited: code => {
            if (code !== 0)
                console.warn("gravity: could not write Qt colours");
        }
    }

    // Ghostty: the "gravity" theme, which /etc/ghostty/gravity picks. Off: a theme that sets
    // nothing, so Ghostty's own colours.
    readonly property string ghosttyTheme: {
        if (!Config.themeGhostty)
            return "# Written by gravity-shell; its colours are turned off in its settings.\n";
        const p = niriPalette;
        const greys = appliedLight ? [p.text, mix(p.dusk, p.textDim, 0.5), p.textDim, p.dusk] : [p.dusk, p.textDim, mix(p.dusk, p.textDim, 0.5), p.text];
        const palette = [greys[0], ...ansiNormal, greys[1], greys[2], ...ansiBright, greys[3]];
        return `# Written by gravity-shell from its colours; edits are overwritten.
background = ${hex(p.night)}
foreground = ${hex(p.text)}
cursor-color = ${hex(p.gold)}
cursor-text = ${hex(p.goldInk)}
selection-background = ${hex(p.tonal)}
selection-foreground = ${hex(p.tonalInk)}
${palette.map((c, i) => `palette = ${i}=${hex(c)}`).join("\n")}
`;
    }

    onGhosttyThemeChanged: ghosttyWrite.restart()

    Timer {
        id: ghosttyWrite

        interval: 200
        onTriggered: {
            if (!Config.ready || !Appearance.ready)
                return;
            ghosttyProc.running = false;
            ghosttyProc.text = root.ghosttyTheme;
            ghosttyProc.running = true;
        }
    }

    // Moved into place like niri's colours; SIGUSR2 makes running Ghostty reload its config.
    Process {
        id: ghosttyProc

        property string text

        command: ["sh", "-c", 'mkdir -p "$0" && printf "%s" "$1" > "$0/gravity.tmp" && mv -f "$0/gravity.tmp" "$0/gravity" && { pkill -USR2 -x ghostty || true; }', root.configHome + "/ghostty/themes", text]
        onExited: code => {
            if (code !== 0)
                console.warn("gravity: could not write ghostty colours");
        }
    }

    Connections {
        target: Appearance

        function onReadyChanged(): void {
            niriWrite.restart();
            gnomeWrite.restart();
            qtWrite.restart();
            ghosttyWrite.restart();
        }
    }

    Timer {
        id: niriWrite

        interval: 200
        onTriggered: {
            if (!Config.ready || !Appearance.ready)
                return;
            niriProc.running = false;
            niriProc.text = root.niriConfig;
            niriProc.running = true;
        }
    }

    // Written to a temporary file and moved into place, so niri never reads half a file.
    Process {
        id: niriProc

        property string text

        command: ["sh", "-c", 'mkdir -p "$0" && printf "%s" "$1" > "$0/niri.kdl.tmp" && mv -f "$0/niri.kdl.tmp" "$0/niri.kdl"', root.cacheDir, text]
        onExited: code => {
            if (code !== 0)
                console.warn("gravity: could not write niri colours");
        }
    }

    FileView {
        id: memoFile

        path: root.cacheDir + "/palettes.json"
        printErrors: false
        blockLoading: true

        onLoaded: {
            try {
                const data = JSON.parse(text());
                if (data && typeof data === "object")
                    root.memo = Object.assign(data, root.memo);
            } catch (e) {}
        }
    }

    Timer {
        id: saveMemo

        interval: 2000
        onTriggered: {
            memoProc.running = false;
            memoProc.text = JSON.stringify(root.memo);
            memoProc.running = true;
        }
    }

    // Written to a temporary file and moved into place, like niri's colours.
    Process {
        id: memoProc

        property string text

        command: ["sh", "-c", 'mkdir -p "$0" && printf "%s" "$1" > "$0/palettes.json.tmp" && mv -f "$0/palettes.json.tmp" "$0/palettes.json"', root.cacheDir, text]
    }

    // Last generated palette, so the shell starts in the right colours without waiting.
    FileView {
        id: cacheFile

        path: root.cacheDir + "/colors.json"
        printErrors: false
        blockLoading: true

        onLoaded: {
            try {
                const data = JSON.parse(text());
                if (data.key && data.palette && Object.keys(root.roles).every(k => data.palette[k])) {
                    root.generated = data.palette;
                    root.generatedKey = data.key;
                    root.cachedKey = data.key;
                    root.appliedGenerated = data.palette;
                }
            } catch (e) {}
            regenerate.restart();
        }
        onLoadFailed: regenerate.restart()
    }
}
