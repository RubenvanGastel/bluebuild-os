#!/bin/sh
# Starts or talks to the Gravity Quickshell desktop.
#   gravity-shell          start the shell (niri runs this at startup)
#   gravity-shell lock     lock the screen
#   gravity-shell wallpaper [image]
#                          open the wallpaper picker, or set the wallpaper to image
#   gravity-shell ...      any other qs arguments, e.g. `gravity-shell ipc show`
#
# A copy in ~/.config/quickshell/gravity takes precedence over the system one, so you can
# tweak it without rebuilding the image:
#   cp -r /usr/share/gravity-shell ~/.config/quickshell/gravity
set -eu

user_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/gravity"
if [ -f "$user_dir/shell.qml" ]; then
    dir="$user_dir"
else
    dir=/usr/share/gravity-shell
fi

# Video wallpapers: decode with VA-API first. On hybrid laptops that is the GPU drawing the
# screen; Qt would otherwise pick CUDA on the NVIDIA one, and copy every frame across.
export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES:-vaapi,cuda}"
# Qt also opens CUDA just to see if it works, which keeps the NVIDIA GPU awake for as long
# as the shell runs (some 5 W on battery). With another GPU around, hide CUDA from the
# shell. Not on NVIDIA-only machines: their VA-API driver itself runs on CUDA.
for vendor in /sys/class/drm/renderD*/device/vendor; do
    if [ "$(cat "$vendor" 2>/dev/null)" != 0x10de ] && [ -e "$vendor" ]; then
        export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES-}"
        break
    fi
done

case "${1:-}" in
    "")
        # The shell's first start: dark, its default. It sets the GTK theme and accent itself.
        # (theme-owner is the marker older images wrote, so existing users keep their choice.)
        state="${XDG_STATE_HOME:-$HOME/.local/state}/gravity-shell"
        if [ ! -e "$state/theme-owner" ]; then
            gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
            mkdir -p "$state" && echo niri >"$state/theme-owner"
        fi
        exec qs -p "$dir"
        ;;
    lock) exec qs -p "$dir" ipc call lock lock ;;
    wallpaper)
        if [ -n "${2:-}" ]; then
            exec qs -p "$dir" ipc call wallpaper set "$(realpath -- "$2")"
        fi
        exec qs -p "$dir" ipc call wallpaper toggle
        ;;
    *) exec qs -p "$dir" "$@" ;;
esac
